{
  "servers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated"
      ]
    },
    "agent-browser": {
      "type": "stdio",
      "command": "agent-browser",
      "args": [
        "mcp"
      ]
    }
  }
}
