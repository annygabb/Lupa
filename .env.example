# LUPA Saúde: variáveis SERVER ONLY. Não usar NEXT_PUBLIC_ para segredos.
# Sem estas variáveis, novas experiências educativas funcionam; LUPA Live retorna 503 (sem dados falsos).
# Isolar projetos e chaves por local, preview e produção.
LUPA_SUPABASE_URL=
LUPA_SUPABASE_SERVICE_ROLE_KEY=
LUPA_LIVE_SIGNING_SECRET=
LUPA_LIVE_ADMIN_TOKEN=

# Em Windows PowerShell, gerar cada segredo com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# NUNCA colocar chaves reais neste arquivo.

# Demonstração LOCAL apenas (jamais em produção):
# LUPA_LIVE_ALLOW_LOCAL_DEMO=true
# Em produção a ausência de banco, segredo ou falha remota devolve indisponibilidade.
# Substituir token transitório por login institucional/RBAC antes de uso real.
