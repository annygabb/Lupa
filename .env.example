# LUPA Saúde — PROJETO SUPABASE EXCLUSIVO (não use bases de outros produtos).
# Configure separadamente Preview/Staging e Production, diretamente no painel Vercel.
# Nunca comite valores reais, nem cole secrets em issues, PRs ou conversas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave com acesso de SERVIÇO só no servidor. Recomendado: sb_secret_...
SUPABASE_SECRET_KEY=

# 32+ caracteres aleatórios, diferentes por ambiente, usados para pseudônimos.
LUPA_LIVE_SIGNING_SECRET=

# Base pública confiável para os QR Codes.
LUPA_APP_BASE_URL=https://lupaa.vercel.app

# Compatibilidade LEGADA; evite usá-las em novos ambientes:
# LUPA_SUPABASE_URL=
# LUPA_SUPABASE_SERVICE_ROLE_KEY=

# Demonstração LOCAL apenas. Nunca coloque true em produção:
# LUPA_LIVE_ALLOW_LOCAL_DEMO=true

# Não existe mais token de admin global.
# Gestão institucional utiliza Supabase Auth e lupa_organization_members.
