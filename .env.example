# LUPA Saúde — variáveis de ambiente. NUNCA comite valores reais.
# Configure Preview/Staging e Production separadamente no painel da Vercel.
#
# O ATLAS público (evidências, comparador, projeções, metodologia) NÃO precisa de nenhuma variável.
# As variáveis abaixo são do LUPA Live (login, organizador, votação, telão). Sem elas, as telas do Live
# informam "LUPA Live indisponível neste ambiente" e a API responde 503 LIVE_UNCONFIGURED.

# Projeto Supabase EXCLUSIVO do LUPA (não reutilize bancos de outros produtos).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave de SERVIÇO, somente no servidor. Recomendado: sb_secret_...
SUPABASE_SECRET_KEY=

# 32+ caracteres aleatórios, diferentes por ambiente (assina a sessão do participante e
# pseudonimiza IP/e-mail nos limites de taxa). Gere com: openssl rand -hex 32
LUPA_LIVE_SIGNING_SECRET=

# Endereço público canônico (QR Codes, recuperação de acesso e lista de origens confiáveis).
LUPA_APP_BASE_URL=https://lupaa.vercel.app

# Opcional: outros domínios do MESMO app que podem enviar escritas (separados por vírgula).
# LUPA_ALLOWED_ORIGINS=https://lupa.exemplo.edu.br

# Opcional: limites de taxa (padrões entre parênteses).
# LUPA_LIVE_MAX_SESSIONS_PER_CLIENT_MINUTE=40   # novas sessões de participante por rede/minuto/evento
# LUPA_LIVE_MAX_VOTES_PER_CLIENT_MINUTE=80      # tentativas de voto por rede/minuto/evento
# LUPA_AUTH_MAX_LOGIN_PER_EMAIL_15MIN=8
# LUPA_AUTH_MAX_LOGIN_PER_CLIENT_15MIN=30
# LUPA_AUTH_MAX_RECOVER_PER_EMAIL_HOUR=3

# Compatibilidade LEGADA; evite em novos ambientes:
# LUPA_SUPABASE_URL=
# LUPA_SUPABASE_SERVICE_ROLE_KEY=

# Demonstração LOCAL em memória (somente `pnpm dev`; ignorada em produção):
# LUPA_LIVE_ALLOW_LOCAL_DEMO=true
